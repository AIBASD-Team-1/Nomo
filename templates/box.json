{
  "id": "box",
  "description": "Cuboid, e.g. for panels, legs, battens",
  "parameters": {
    "length": {
      "unit": "mm",
      "min": 1,
      "max": 10000,
      "default": 100
    },
    "width": {
      "unit": "mm",
      "min": 1,
      "max": 10000,
      "default": 100
    },
    "height": {
      "unit": "mm",
      "min": 1,
      "max": 10000,
      "default": 100
    }
  },
  "rules": [
    {
      "check": "length > 10",
      "message": "length must be greater than 10",
      "parameter": "length"
    },
    {
      "check": "width > 10",
      "message": "width must be greater than 10",
      "parameter": "width"
    },
    {
      "check": "height > 10",
      "message": "height must be greater than 10",
      "parameter": "height"
    }
  ],
  "origin": "centre of the bottom face; length along X, width along Y, height along Z"
}
