# OpenRouter API, free models only. Put OPENROUTER_API_KEY=... in .env (git-ignored).
NOMO_PROVIDER=openrouter
# Default in config.json: recursive/flint-v1.0:free, no effort. Uncomment to change:
# NOMO_OPENROUTER_MODEL=recursive/flint-v1.0:free   # any model ending in :free
# NOMO_OPENROUTER_EFFORT=low                        # low, medium, high (models without reasoning ignore it)
