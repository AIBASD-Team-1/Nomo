# Claude Code CLI (`claude`), installed and signed in. No key needed.
NOMO_PROVIDER=claude-code
# Defaults in config.json: sonnet, low. Uncomment to change:
# NOMO_CLAUDE_CODE_MODEL=sonnet        # sonnet, opus, haiku, fable or a full model name
# NOMO_CLAUDE_CODE_EFFORT=low          # low, medium, high, xhigh, max
