# Copy to .env (git-ignored). Shell variables win over this file.

# Which provider from config.json to use (default: "provider" in config.json).
# Or pick a committed preset instead: python cli.py --env-file .env.claude
NOMO_PROVIDER=openrouter
# Optional: override the default model / effort of the chosen provider (see config.json)
# NOMO_MODEL=recursive/flint-v1.0:free
# NOMO_EFFORT=high

# OpenRouter key, only needed for the openrouter provider (free models only!)
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key
