# GitHub Copilot CLI (`copilot`), installed and signed in. No key needed.
NOMO_PROVIDER=copilot
# Defaults in config.json: claude-opus-5.5, low. Uncomment to change:
# NOMO_COPILOT_MODEL=claude-opus-5.5   # e.g. gpt-5.6-sol, or auto to let Copilot pick
# NOMO_COPILOT_EFFORT=low              # none, minimal, low, medium, high, xhigh, max (depends on the model)
